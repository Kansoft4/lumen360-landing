</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;motion&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;showFab&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;galleryAutoplay&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;marqueeSpeed&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:26,&quot;min&quot;:8,&quot;max&quot;:60,&quot;step&quot;:1,&quot;unit&quot;:&quot;s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;faqAllowMultiple&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;}}">
class Component extends DCLogic {
  state = { slide: 0, perView: 3, faqOpen: 0 };
  heroVideo = React.createRef();

  base = [
    { icon: 'ph-map-pin', badge: 'Ciudad Jardín', title: 'Apartamento 3 alcobas', sub: 'Recorrido completo + vista de muñeca.', ph: 'tour — sala y comedor con doble altura' },
    { icon: 'ph-map-pin', badge: 'El Peñón', title: 'Loft remodelado', sub: 'Escaneo con muebles retirados.', ph: 'tour — loft con ventanal a la calle' },
    { icon: 'ph-map-pin', badge: 'Granada', title: 'Penthouse con terraza', sub: 'Medición en vivo de cada espacio.', ph: 'tour — terraza con vista a los cerros' }
  ];

  stack = [
    { initials: 'AM', name: 'Andrés Muñoz', role: '', quote: '“Antes sacaba una tarde entera para mostrar seis apartamentos. Ahora les mando el link, ellos escogen, y salgo a mostrar dos. Recorro mucho menos la ciudad y el cliente llega decidido.”' },
    { initials: 'CR', name: 'Carolina Rivas', role: '', quote: '“Vendí un apartamento a un cliente que estaba en Miami. Lo recorrió completo por el tour, hicimos una videollamada y cerró sin venir a Cali.”' },
    { initials: 'JT', name: 'Julián Torres', role: '', quote: '“[Espacio reservado para el tercer testimonio.]”' }
  ];

  faqData = [
    { q: '¿Cuánto cuesta un tour?', a: 'Desde $500.000 por propiedad, sin mensualidad ni contrato. El primero va por nuestra cuenta, así que puedes probarlo sin arriesgar nada.' },
    { q: '¿En cuánto tiempo lo tengo listo?', a: 'Escaneamos la propiedad en una visita de una a dos horas y te entregamos el link en 24 horas.' },
    { q: '¿Qué necesito tener listo el día del escaneo?', a: 'Solo el acceso a la propiedad y las luces encendidas. Nosotros llevamos el equipo y no movemos nada del propietario.' },
    { q: '¿El tour abre en el celular de mi cliente?', a: 'Sí. Es un link que abre en cualquier navegador, sin descargar nada. Lo mandas por WhatsApp, lo pones en Instagram o en el portal donde publicas.' },
    { q: '¿El apartamento está amoblado y se ve recargado?', a: 'Quitamos los muebles digitalmente para que el comprador vea el espacio real, sin que tengas que pedirle nada al propietario.' },
    { q: '¿Cubren toda Cali?', a: 'Cali y municipios cercanos. Escríbenos por WhatsApp con la dirección y te confirmamos de una vez.' }
  ];

  get slides() { return this.base.concat(this.base); }

  componentDidMount() {
    const v = this.heroVideo && this.heroVideo.current;
    if (v) { v.muted = true; const p = v.play(); if (p && p.catch) p.catch(() => {}); }
    this.fit = () => {
      const w = window.innerWidth;
      const n = w >= 1024 ? 3 : w >= 680 ? 2 : 1;
      this.setState(s => ({ perView: n, slide: Math.min(s.slide, this.slides.length - n) }));
    };
    this.fit();
    window.addEventListener('resize', this.fit);
    if (this.props.galleryAutoplay !== false) this.timer = setInterval(() => this.go(1), 5000);
    this.setupMotion();
    this.motionRescan = [setTimeout(() => this.setupMotion(), 400), setTimeout(() => this.setupMotion(), 1600)];
  }

  componentWillUnmount() {
    window.removeEventListener('resize', this.fit);
    clearInterval(this.timer);
    (this.motionRescan || []).forEach(clearTimeout);
    if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
    if (this.io) this.io.disconnect();
  }

  setupMotion() {
    if (this.props.motion === false) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const E = 'cubic-bezier(.22,.8,.2,1)';
    const prep = el => {
      if (el.dataset.motionReady) return false;
      el.dataset.motionReady = '1';
      el.style.willChange = 'opacity,transform,filter';
      el.style.opacity = '0';
      el.style.transform = 'translateY(22px)';
      el.style.filter = 'blur(7px)';
      el.style.transition = 'opacity .85s ' + E + ', transform .85s ' + E + ', filter .85s ' + E;
      return true;
    };
    const show = (el, d) => setTimeout(() => {
      el.style.opacity = '1';
      el.style.transform = 'none';
      el.style.filter = 'none';
      setTimeout(() => { el.style.willChange = ''; el.style.transition = ''; }, 1200);
    }, d);

    document.querySelectorAll('[data-enter]').forEach((el, i) => { if (prep(el)) show(el, 140 + i * 110); });

    if (!this.io) this.io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        this.io.unobserve(e.target);
        const sibs = Array.from(e.target.parentElement.children).filter(n => n.hasAttribute('data-reveal'));
        show(e.target, Math.max(0, sibs.indexOf(e.target)) * 95);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.06 });
    document.querySelectorAll('[data-reveal]').forEach(el => { if (prep(el)) this.io.observe(el); });

    this.para = Array.from(document.querySelectorAll('[data-parallax]'));
    if (!this.onScroll) {
      this.onScroll = () => {
        if (this.raf) return;
        this.raf = requestAnimationFrame(() => {
          this.raf = null;
          const vh = window.innerHeight || 800;
          this.para.forEach(el => {
            const r = el.getBoundingClientRect();
            const p = (r.top + r.height / 2 - vh / 2) / vh;
            el.style.translate = '0 ' + (p * -30).toFixed(1) + 'px';
          });
        });
      };
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.onScroll();
    }
    clearTimeout(this.motionSafety);
    this.motionSafety = setTimeout(() => {
      document.querySelectorAll('[data-reveal]').forEach(el => {
        if (el.style.opacity === '0' && el.getBoundingClientRect().top < (window.innerHeight || 800)) show(el, 0);
      });
    }, 2600);
  }

  go(d) {
    this.setState(s => {
      const max = this.slides.length - s.perView;
      let n = s.slide + d;
      if (n > max) n = 0;
      if (n < 0) n = max;
      return { slide: n };
    });
  }

  renderVals() {
    const gap = 16;
    const n = this.state.perView;
    const step = `((100% - ${(n - 1) * gap}px) / ${n} + ${gap}px)`;
    const max = this.slides.length - n;
    return {
      slides: this.slides,
      stackTwice: this.stack.concat(this.stack),
      showFab: this.props.showFab !== false,
      slideBasis: `calc((100% - ${(n - 1) * gap}px) / ${n})`,
      trackX: `translateX(calc(${-this.state.slide} * ${step}))`,
      marqueeDur: (this.props.marqueeSpeed || 26) + 's',
      heroVideo: this.heroVideo,
      prev: () => { clearInterval(this.timer); this.go(-1); },
      next: () => { clearInterval(this.timer); this.go(1); },
      dots: this.slides.map((_, i) => ({
        w: i === this.state.slide ? '18px' : '6px',
        bg: i === this.state.slide ? '#09BC8A' : '#B6C7CA',
        go: () => { clearInterval(this.timer); this.setState({ slide: Math.min(i, max) }); }
      })),
      faqs: this.faqData.map((f, i) => ({
        q: f.q,
        a: f.a,
        open: this.state.faqOpen === i,
        rows: this.state.faqOpen === i ? '1fr' : '0fr',
        op: this.state.faqOpen === i ? '1' : '0',
        rot: this.state.faqOpen === i ? 'rotate(45deg)' : 'rotate(0deg)',
        toggle: () => this.setState(s => ({ faqOpen: s.faqOpen === i ? null : i }))
      }))
    };
  }
}

</script>
