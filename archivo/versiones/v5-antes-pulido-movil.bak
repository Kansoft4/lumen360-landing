<script type="text/x-dc" data-dc-script data-props="{&quot;motion&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;showFab&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;galleryAutoplay&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;marqueeSpeed&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:26,&quot;min&quot;:8,&quot;max&quot;:60,&quot;step&quot;:1,&quot;unit&quot;:&quot;s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Comportamiento&quot;},&quot;faqAllowMultiple&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Comportamiento&quot;}}">
class Component extends DCLogic {
  state = { faqOpen: 0 };
  heroVideo = React.createRef();

  stack = [
    { initials: 'AM', name: 'Andrés Muñoz', role: '', quote: '“Antes sacaba una tarde entera para mostrar seis apartamentos. Ahora les mando el link, ellos escogen, y salgo a mostrar dos. Recorro mucho menos la ciudad y el cliente llega decidido.”' },
    { initials: 'CR', name: 'Carolina Rivas', role: '', quote: '“Vendí un apartamento a un cliente que estaba en Miami. Lo recorrió completo por el tour, hicimos una videollamada y cerró sin venir a Cali.”' }
  ];

  faqData = [
    { q: '¿Cuánto cuesta un tour?', a: 'Desde $500.000 por propiedad, sin mensualidad ni contrato. El primero va por nuestra cuenta.' },
    { q: '¿En cuánto tiempo lo tengo listo?', a: 'Una visita de una a dos horas, y el link te llega en 24 horas.' },
    { q: '¿Qué necesito tener listo el día del escaneo?', a: 'El acceso y las luces encendidas. Llevamos el equipo y no movemos nada.' },
    { q: '¿El tour abre en el celular de mi cliente?', a: 'Sí. Abre en cualquier navegador, sin descargar nada. Lo mandas por WhatsApp o lo publicas donde quieras.' },
    { q: '¿El apartamento está amoblado y se ve recargado?', a: 'Quitamos los muebles digitalmente, sin pedirle nada al propietario.' },
    { q: '¿Cubren toda Cali?', a: 'Cali y municipios cercanos. Mándanos la dirección y te confirmamos.' }
  ];

  componentDidMount() {
    const v = this.heroVideo && this.heroVideo.current;
    if (v) { v.muted = true; const p = v.play(); if (p && p.catch) p.catch(() => {}); }
    // el carrusel se reemplazo por la grilla de reels de Instagram; ya no hay autoplay que correr
    this.setupMotion();
    this.motionRescan = [setTimeout(() => this.setupMotion(), 400), setTimeout(() => this.setupMotion(), 1600)];
  }

  componentWillUnmount() {
    (this.motionRescan || []).forEach(clearTimeout);
    if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
    if (this.io) this.io.disconnect();
  }

  setupMotion() {
    if (this.props.motion === false) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const E = 'cubic-bezier(.22,.8,.2,1)';
    const prep = el => {
      if (el.dataset.motionReady) return false;
      el.dataset.motionReady = '1';
      el.style.willChange = 'opacity,transform,filter';
      el.style.opacity = '0';
      el.style.transform = 'translateY(22px)';
      el.style.filter = 'blur(7px)';
      el.style.transition = 'opacity .85s ' + E + ', transform .85s ' + E + ', filter .85s ' + E;
      return true;
    };
    const show = (el, d) => setTimeout(() => {
      el.style.opacity = '1';
      el.style.transform = 'none';
      el.style.filter = 'none';
      setTimeout(() => { el.style.willChange = ''; el.style.transition = ''; }, 1200);
    }, d);

    document.querySelectorAll('[data-enter]').forEach((el, i) => { if (prep(el)) show(el, 140 + i * 110); });

    if (!this.io) this.io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        this.io.unobserve(e.target);
        const sibs = Array.from(e.target.parentElement.children).filter(n => n.hasAttribute('data-reveal'));
        show(e.target, Math.max(0, sibs.indexOf(e.target)) * 95);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.06 });
    document.querySelectorAll('[data-reveal]').forEach(el => { if (prep(el)) this.io.observe(el); });

    this.para = Array.from(document.querySelectorAll('[data-parallax]'));
    if (!this.onScroll) {
      this.onScroll = () => {
        if (this.raf) return;
        this.raf = requestAnimationFrame(() => {
          this.raf = null;
          const vh = window.innerHeight || 800;
          this.para.forEach(el => {
            const r = el.getBoundingClientRect();
            const p = (r.top + r.height / 2 - vh / 2) / vh;
            el.style.translate = '0 ' + (p * -30).toFixed(1) + 'px';
          });
        });
      };
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.onScroll();
    }
    clearTimeout(this.motionSafety);
    this.motionSafety = setTimeout(() => {
      document.querySelectorAll('[data-reveal]').forEach(el => {
        if (el.style.opacity === '0' && el.getBoundingClientRect().top < (window.innerHeight || 800)) show(el, 0);
      });
    }, 2600);
  }

  renderVals() {
    return {
      stackTwice: this.stack.concat(this.stack),
      showFab: this.props.showFab !== false,
      marqueeDur: (this.props.marqueeSpeed || 26) + 's',
      heroVideo: this.heroVideo,
      faqs: this.faqData.map((f, i) => ({
        q: f.q,
        a: f.a,
        expanded: this.state.faqOpen === i ? 'true' : 'false',
        panelId: 'faq-panel-' + i,
        rows: this.state.faqOpen === i ? '1fr' : '0fr',
        op: this.state.faqOpen === i ? '1' : '0',
        rot: this.state.faqOpen === i ? 'rotate(45deg)' : 'rotate(0deg)',
        toggle: () => this.setState(s => ({ faqOpen: s.faqOpen === i ? null : i }))
      }))
    };
  }
}

</script>

<!-- ══ REELS DE INSTAGRAM (dinamico) ══
     Trae los reels mas recientes de @lumen360.co y los pinta en la grilla de
     la seccion "Tours", con el diseño de la pagina.

     COMO ACTIVARLO (5 min, gratis):
       1. Entra a https://behold.so y crea una cuenta.
       2. "Connect an Instagram account" -> autoriza @lumen360.co por OAuth.
          Ojo: Instagram exige cuenta Business o Creator. Si la tuya es
          Personal, cambiala en Instagram > Configuracion > Tipo de cuenta.
       3. "+ Add Feed" -> tipo JSON -> en "Allowed post types" deja solo Reels.
       4. Copia el ID del feed y pegalo abajo en FEED_ID.

     Por que Behold y no la API de Instagram directo: Meta cerro la Basic
     Display API en diciembre de 2024. La Graph API que la reemplaza necesita
     un access token, y en una pagina estatica ese token quedaria visible en
     el codigo fuente para cualquiera. Behold guarda el token de su lado y
     expone solo un JSON publico de lectura, sin credenciales.

     Si FEED_ID esta vacio o la peticion falla, la seccion entera se oculta
     sola (y su link en el footer), para no dejar un hueco en la pagina. -->
<script>
(function () {
  // ─────────────────────────────────────────────────────────────────────
  //  PEGA ACA EL ID DE TU FEED DE BEHOLD  ->  https://behold.so
  var FEED_ID = 'FE3c1kRUf86qBCeQTeYQ';   // @lumen360.co
  // ─────────────────────────────────────────────────────────────────────

  var MAX = 3;   // cuantos reels mostrar

  var PERFIL = 'https://www.instagram.com/lumen360.co/';

  // Vista previa SOLO en local, con los videos que ya estan en /assets, para
  // ver como queda la seccion antes de conectar Instagram. En cualquier dominio
  // real esto no corre, asi que no hay forma de publicarlo por olvido.
  var enLocal = ['localhost', '127.0.0.1', ''].indexOf(location.hostname) !== -1;
  var esDemo  = !FEED_ID && enLocal;

  var POSTS_DEMO = [
    { mediaType: 'VIDEO', isReel: true, permalink: PERFIL, timestamp: new Date().toISOString(),
      mediaUrl: 'assets/tour-vista-muneca.mp4',  prunedCaption: 'Vista de muñeca: la distribucion completa en tres segundos.',
      sizes: { medium: { mediaUrl: 'assets/hero-loft-hd.jpg' } }, colorPalette: { dominant: '23,42,58' } },
    { mediaType: 'VIDEO', isReel: true, permalink: PERFIL, timestamp: new Date(Date.now() - 864e5 * 3).toISOString(),
      mediaUrl: 'assets/tour-quita-muebles.mp4', prunedCaption: 'Quitamos los muebles digitalmente y queda el espacio real.',
      sizes: { medium: { mediaUrl: 'assets/hero-loft-hd.jpg' } }, colorPalette: { dominant: '23,42,58' } },
    { mediaType: 'VIDEO', isReel: true, permalink: PERFIL, timestamp: new Date(Date.now() - 864e5 * 8).toISOString(),
      mediaUrl: 'assets/tour-medicion.mp4',      prunedCaption: 'Tu comprador mide cualquier pared desde el mismo link.',
      sizes: { medium: { mediaUrl: 'assets/hero-loft-hd.jpg' } }, colorPalette: { dominant: '23,42,58' } }
  ];

  var htmlTarjetas = null;

  // OJO: el runtime de la plantilla no solo re-renderiza, REEMPLAZA los nodos.
  // Guardar una referencia al elemento no sirve: queda apuntando a un nodo
  // desconectado y escribir en el no se ve. Por eso siempre consultamos fresco.
  function grid() { return document.getElementById('ig-reels'); }

  function cuandoExista(cb, intentos) {
    intentos = (intentos === undefined) ? 60 : intentos;
    if (document.getElementById('tours') && grid()) return cb();
    if (intentos <= 0) return;
    setTimeout(function () { cuandoExista(cb, intentos - 1); }, 100);
  }

  // Pinta si hace falta. Devuelve true si la grilla viva ya tiene contenido.
  function pintar() {
    var g = grid();
    if (!g || !htmlTarjetas) return false;
    if (g.childElementCount > 0) return true;
    g.innerHTML = htmlTarjetas;
    autoplay(g);
    return true;
  }

  // Regla CSS en vez de style inline: el runtime re-renderiza y restaura el
  // atributo style original, borrando cualquier display:none puesto al elemento.
  function ocultarSeccion() {
    if (document.getElementById('ig-reels-hide')) return;
    var regla = document.createElement('style');
    regla.id = 'ig-reels-hide';
    regla.textContent = '#tours,a[href="#tours"]{display:none!important}';
    document.head.appendChild(regla);
  }
  function mostrarSeccion() {
    var r = document.getElementById('ig-reels-hide');
    if (r) r.remove();
  }

  function esc(t) {
    return String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function fecha(iso) {
    try { return new Date(iso).toLocaleDateString('es-CO', { day: 'numeric', month: 'short' }); }
    catch (e) { return ''; }
  }

  function tarjeta(post) {
    var sizes  = post.sizes || {};
    // El poster sale de Behold (hop.behold.pictures), no del thumbnailUrl de
    // Instagram. El de Instagram viene 9:16 y se veria mejor, PERO vence en dias
    // igual que la URL del video. Y el poster es justamente la red de seguridad:
    // si el video no carga, es lo unico que queda. Tiene que ser lo estable.
    // Se recorta cuadrado, pero solo se ve un instante antes de que arranque el video.
    var poster = (sizes.medium || sizes.large || sizes.small || {}).mediaUrl || post.thumbnailUrl || '';
    var rgb    = (post.colorPalette && post.colorPalette.dominant) || '214,226,227';
    var cap    = (post.prunedCaption || '').replace(/\s+/g, ' ').trim();
    if (cap.length > 88) cap = cap.slice(0, 86).trim() + '…';
    var alt    = post.altText || cap || 'Publicacion de Instagram de Lumen 360';
    var video  = post.mediaType === 'VIDEO' && post.mediaUrl;

    // Los reels arrancan sin src: el IntersectionObserver se lo pone recien
    // cuando entran en pantalla, para no bajar tres videos de una.
    var media = video
      ? '<video data-reel-video="" data-src="' + esc(post.mediaUrl) + '" poster="' + esc(poster) + '"' +
          ' muted loop playsinline preload="none" aria-label="' + esc(alt) + '"' +
          ' style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"></video>'
      : '<img src="' + esc(poster) + '" alt="' + esc(alt) + '" loading="lazy" decoding="async"' +
          ' data-zoom-img="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block">';

    var pie = video
      ? '<i aria-hidden="true" class="ph-fill ph-speaker-simple-slash" style="font-size:14px;line-height:1"></i>'
      : '<i aria-hidden="true" class="ph-fill ph-image-square" style="font-size:14px;line-height:1"></i>';

    return '' +
      '<a href="' + esc(post.permalink) + '" target="_blank" rel="noopener" data-zoom="" data-reel=""' +
        ' aria-label="Ver en Instagram"' +
        ' style="position:relative;display:block;aspect-ratio:9/16;border-radius:22px;overflow:hidden;' +
                'background:rgb(' + esc(rgb) + ');box-shadow:0 1px 2px rgba(0,0,0,.03),0 22px 44px -30px rgba(0,0,0,.5)">' +
        media +
        '<span style="position:absolute;left:0;right:0;bottom:0;height:58%;pointer-events:none;' +
              'background:linear-gradient(180deg,transparent,rgba(10,10,10,.82))"></span>' +
        '<span aria-hidden="true" style="position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:999px;' +
              'background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;color:#172A3A">' +
          '<i aria-hidden="true" class="ph-fill ph-instagram-logo" style="font-size:15px;line-height:1"></i></span>' +
        '<div style="position:absolute;left:18px;right:18px;bottom:20px;color:#fff;pointer-events:none">' +
          '<span style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:rgba(255,255,255,.85)">' +
            pie + esc(fecha(post.timestamp)) + '</span>' +
          (cap ? '<p style="margin:8px 0 0;font-size:14.5px;line-height:1.45;font-weight:500;text-wrap:pretty">' + esc(cap) + '</p>' : '') +
        '</div>' +
      '</a>';
  }

  // Reproduccion automatica y sin sonido, solo mientras el reel esta en pantalla.
  function autoplay(root) {
    var videos = root.querySelectorAll('[data-reel-video]');
    if (!videos.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;  // se queda el poster

    if (!('IntersectionObserver' in window)) {
      Array.prototype.forEach.call(videos, function (v) { arrancar(v); });
      return;
    }

    var io = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) {
        if (e.isIntersecting) arrancar(e.target);
        else e.target.pause();
      });
    }, { threshold: 0.25 });

    Array.prototype.forEach.call(videos, function (v) { io.observe(v); });
  }

  function arrancar(v) {
    if (!v.getAttribute('src') && v.dataset.src) v.setAttribute('src', v.dataset.src);
    v.muted = true;                       // iOS exige muted para autoplay
    var pr = v.play();
    if (pr && pr.catch) pr.catch(function () {});
  }

  cuandoExista(function () {
    if (!FEED_ID && !esDemo) {
      console.info('[reels] falta FEED_ID de Behold: la seccion de Instagram queda oculta.');
      ocultarSeccion();
      return;
    }

    var origen;
    if (esDemo) {
      console.warn('[reels] VISTA PREVIA local con los videos de /assets. ' +
                   'Pega tu FEED_ID de Behold para mostrar los reels reales de @lumen360.co.');
      origen = Promise.resolve({ posts: POSTS_DEMO });
    } else {
      origen = fetch('https://feeds.behold.so/' + FEED_ID)
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
    }

    origen
      .then(function (data) {
        var posts = data.posts || [];

        var reels = posts.filter(function (post) {
          return post.mediaType === 'VIDEO' && post.isReel !== false && post.mediaUrl;
        });

        // Si el feed no trae reels no dejamos la seccion vacia: mostramos las
        // publicaciones mas recientes igual, y avisamos por consola.
        var elegidos = reels.length ? reels : posts;
        if (!reels.length && posts.length) {
          console.warn('[reels] el feed no trae reels; se muestran las publicaciones mas recientes. ' +
                       'En Behold, feed > "Allowed post types" > deja solo Reels.');
        }

        elegidos = elegidos.slice(0, MAX);
        if (!elegidos.length) {
          console.warn('[reels] el feed vino vacio: se oculta la seccion.');
          ocultarSeccion();
          return;
        }

        mostrarSeccion();
        htmlTarjetas = elegidos.map(tarjeta).join('');
        pintar();

        // Reintentamos un rato: si el runtime reemplaza el nodo despues de que
        // pintamos, la grilla nueva vuelve vacia y hay que volver a llenarla.
        var reintentos = 0;
        var iv = setInterval(function () {
          pintar();
          if (++reintentos > 24) clearInterval(iv);   // ~6 s y paramos
        }, 250);
      })
      .catch(function (err) {
        console.warn('[reels] no se pudo cargar el feed de Instagram:', err);
        ocultarSeccion();
      });
  });
})();
</script>

<!-- ══ VIDEOS: autoplay mudo que funcione en iOS ══
     Dos bugs que arregla esto:

     1. El runtime de la plantilla setea muted como PROPIEDAD de React, pero
        nunca escribe el ATRIBUTO muted en el HTML. iOS mira el atributo al
        parsear y por eso bloqueaba el autoplay: quedaba el recuadro gris.
        Aca se lo ponemos a mano, como atributo de verdad.

     2. Los videos cargaban aunque estuvieran fuera de pantalla. Ahora el src
        se asigna recien cuando entran al viewport, y se pausan al salir.

     En movil el video vertical del hero se elimina del todo (no solo se
     oculta): se le quita el src para que no gaste datos. -->
<script>
(function () {
  var esMovil = window.matchMedia('(max-width: 760px)').matches;
  var io = null;

  function arrancar(v) {
    if (!v.getAttribute('src') && v.dataset.src) v.setAttribute('src', v.dataset.src);
    v.muted = true;
    var pr = v.play();
    if (pr && pr.catch) pr.catch(function () {});   // si falla, queda el poster
  }

  function preparar() {
    var vids = document.querySelectorAll('[data-loop]');
    if (!vids.length) return false;

    Array.prototype.forEach.call(vids, function (v) {
      if (v.dataset.listo) return;
      v.dataset.listo = '1';

      // el atributo, no solo la propiedad: es lo que mira iOS
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      v.muted = true;

      if (esMovil && v.hasAttribute('data-hero-video')) {
        v.removeAttribute('src');       // no lo descargues siquiera
        v.removeAttribute('autoplay');
        v.load();
        return;
      }

      // diferir la descarga hasta que se vea
      if (v.getAttribute('src')) {
        v.dataset.src = v.getAttribute('src');
        v.removeAttribute('src');
        v.removeAttribute('autoplay');
        v.load();
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      if (!('IntersectionObserver' in window)) { arrancar(v); return; }
      if (!io) {
        io = new IntersectionObserver(function (ents) {
          ents.forEach(function (e) { e.isIntersecting ? arrancar(e.target) : e.target.pause(); });
        }, { threshold: 0.2 });
      }
      io.observe(v);
    });
    return true;
  }

  // el runtime pinta async y ademas reemplaza nodos: reintentamos un rato
  var n = 0;
  var iv = setInterval(function () { preparar(); if (++n > 30) clearInterval(iv); }, 200);
  preparar();
})();
</script>
</body>
</html>
