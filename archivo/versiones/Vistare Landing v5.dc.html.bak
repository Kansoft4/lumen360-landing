<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css" />
<style>
  /* Lumen 360 — landing de conversión (Cali). Paleta: Jet Black #172A3A,
     Dark Teal #004346, Mint Leaf #09BC8A, blanco frío #EFF4F4.
     Todos los CTA apuntan a WhatsApp +57 301 149 3222 con mensaje precargado
     distinto por sección (así se sabe de dónde vino el lead). */
  body { margin: 0; background: #EFF4F4; font-family: 'Hanken Grotesk', -apple-system, Segoe UI, sans-serif; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  a { color: #172A3A; text-decoration: none; }
  a:hover { color: #3F5A66; }
  button { font-family: inherit; }
  @keyframes vis-marquee { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
  @keyframes vis-vscroll { from { transform: translate3d(0,0,0); } to { transform: translate3d(0,-50%,0); } }
  @keyframes vis-pulse { 0% { transform: scale(1); opacity: .55; } 70% { transform: scale(1.75); opacity: 0; } 100% { transform: scale(1.75); opacity: 0; } }
  @keyframes vis-ring { 0% { transform: scale(1); opacity: .5; } 70% { transform: scale(1.6); opacity: 0; } 100% { transform: scale(1.6); opacity: 0; } }
  [data-zoom-img] { transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  [data-zoom]:hover [data-zoom-img] { transform: scale(1.07); }
  [data-marquee]:hover > div { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
    [data-reveal], [data-enter] { opacity: 1 !important; transform: none !important; filter: none !important; }
  }
  @media (max-width: 1100px) { [data-hero] { gap: 32px !important; } }
  @media (max-width: 980px) {
    [data-hero] { grid-template-columns: 1fr !important; }
    [data-pricing] { grid-template-columns: 1fr !important; }
    [data-testimonial] { grid-template-columns: 1fr !important; }
    [data-quote] { margin-right: 0 !important; }
    [data-footer-top] { grid-template-columns: 1fr !important; gap: 44px !important; }
    [data-pricing-stack] { height: 460px !important; }
  }
  @media (max-width: 760px) {
    [data-3col] { grid-template-columns: 1fr !important; }
    [data-steps] { grid-template-columns: 1fr !important; }
    [data-trusted] { flex-direction: column !important; align-items: flex-start !important; gap: 22px !important; }
    [data-faq-head] { flex-direction: column !important; align-items: flex-start !important; gap: 18px !important; }
    [data-results-row] { grid-template-columns: 1fr !important; }
    [data-footbar] { flex-direction: column !important; gap: 10px !important; align-items: flex-start !important; }
    [data-ctaband] { flex-direction: column !important; align-items: flex-start !important; }
    [data-ctaband] > a { width: 100% !important; justify-content: center !important; }
  }
  @media (max-width: 520px) {
    [data-links-2col] { grid-template-columns: 1fr !important; gap: 32px !important; }
    [data-fab-label] { display: none !important; }
    [data-hero-ctas] > a { width: 100% !important; justify-content: center !important; }
  }
</style>
</helmet>

<div style="background:#EFF4F4;padding:0;color:#172A3A">

  <template id="__bundler_thumbnail">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <rect width="100" height="100" fill="#172A3A" />
      <text x="50" y="62" text-anchor="middle" font-family="Helvetica,Arial,sans-serif" font-size="34" font-weight="700" fill="#fff">L</text>
    </svg>
  </template>

  <div style="width:100%;margin:0 auto;background:#EFF4F4;border-radius:0;overflow:hidden">

    <!-- ── HERO ── -->
    <section id="top" style="position:relative;width:100%;background-image:url('assets/hero-loft-hd.jpg');background-size:cover;background-position:center 46%;overflow:hidden">
      <span style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(239,244,244,.97) 0%,rgba(239,244,244,.95) 38%,rgba(239,244,244,.72) 56%,rgba(239,244,244,.3) 76%,rgba(239,244,244,.06) 100%)"></span>
      <span style="position:absolute;left:0;right:0;bottom:0;height:34%;background:linear-gradient(to top,#EFF4F4 0%,rgba(239,244,244,.75) 45%,rgba(239,244,244,0) 100%)"></span>
      <div style="position:relative;width:100%;max-width:1320px;margin:0 auto;padding:clamp(28px,4vw,54px) clamp(20px,4vw,60px) clamp(28px,4vw,54px)">
      <div data-hero="" style="display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,5vw,72px);align-items:center">
        <div>
          <span data-enter="" style="display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border-radius:999px;background:#E4EDEE;border:1px solid #CBDCDE;box-shadow:0 1px 2px rgba(0,0,0,.04);font-size:13px;font-weight:500;color:#3F5A66">
            <i class="ph ph-cube" style="font-size:14px;line-height:1;color:#09BC8A"></i>
            Tours virtuales 360° en Cali
          </span>
          <h1 data-enter="" style="margin:24px 0 0;max-width:12ch;font-size:clamp(38px,5.6vw,80px);line-height:1.04;letter-spacing:-.035em;font-weight:800;color:#172A3A;text-wrap:balance">
            Vende apartamentos con <span style="font-family:'Playfair Display',serif;font-style:italic;font-weight:500;letter-spacing:-.02em">la mitad</span> de las visitas.
          </h1>
          <p data-enter="" style="margin:22px 0 0;max-width:440px;font-size:clamp(15px,1.25vw,17px);line-height:1.9;color:#3F5A66;text-wrap:pretty">Tu comprador recorre la propiedad completa antes de pedirte una cita. Escaneamos tu primera propiedad gratis y te entregamos el link en 24 horas.</p>
          <div data-enter="" data-hero-ctas="" style="margin-top:30px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <a href="https://wa.me/573011493222?text=Hola%2C%20quiero%20reclamar%20el%20tour%20virtual%20360%20gratis%20de%20una%20propiedad%20en%20Cali." target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;padding:16px 26px;border-radius:12px;background:#172A3A;color:#fff;font-size:16px;font-weight:600;letter-spacing:-.01em;box-shadow:0 14px 26px -14px rgba(0,0,0,.85);transition:transform .25s cubic-bezier(.2,.8,.2,1),background .25s" style-hover="transform:translateY(-2px);background:#004346;color:#fff">
              <i class="ph-fill ph-whatsapp-logo" style="font-size:19px;line-height:1;color:#09BC8A"></i>
              Reclamar mi tour gratis
            </a>
            <a href="#tours" style="display:inline-flex;align-items:center;gap:9px;padding:16px 22px;border-radius:12px;background:rgba(255,255,255,.7);border:1px solid #CBDCDE;color:#172A3A;font-size:15px;font-weight:500;transition:transform .25s cubic-bezier(.2,.8,.2,1),background .25s" style-hover="transform:translateY(-2px);background:#fff;color:#172A3A">
              <i class="ph ph-play-circle" style="font-size:17px;line-height:1"></i>
              Ver un tour por dentro
            </a>
          </div>
          <div data-enter="" style="margin-top:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:13.5px;color:#5B7581">
            <span style="display:inline-flex;align-items:center;gap:6px"><i class="ph-fill ph-check-circle" style="font-size:15px;color:#09BC8A"></i>Respuesta en minutos</span>
            <span style="display:inline-flex;align-items:center;gap:6px"><i class="ph-fill ph-check-circle" style="font-size:15px;color:#09BC8A"></i>Sin contrato ni mensualidad</span>
            <span style="display:inline-flex;align-items:center;gap:6px"><i class="ph-fill ph-check-circle" style="font-size:15px;color:#09BC8A"></i>Entrega en 24 horas</span>
          </div>
        </div>
        <div data-enter="" data-parallax="" style="justify-self:center;width:100%;max-width:334px;aspect-ratio:.52;position:relative;border-radius:clamp(20px,2.2vw,30px);overflow:hidden;box-shadow:0 40px 70px -40px rgba(0,0,0,.55),0 4px 14px -6px rgba(0,0,0,.12)">
          <video data-zoom-img="" src="assets/reel_loop_3.mp4" poster="assets/hero-loft-hd.jpg" ref="{{ heroVideo }}" autoPlay="{{ true }}" muted="{{ true }}" loop="{{ true }}" playsInline="{{ true }}" preload="auto" aria-label="Recorrido en video de un apartamento con ventanales de piso a techo y vista a la ciudad" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:52% 46%;display:block"></video>
          <div style="position:absolute;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:flex-end;gap:10px">
            <span style="color:rgba(255,255,255,.85);font-size:16px;line-height:1;letter-spacing:.05em">···</span>
          </div>
        </div>
      </div>

      </div>
    </section>

    <!-- ── SERVICIOS ── -->
    <section id="servicios" style="width:100%;max-width:1320px;margin:0 auto;padding:clamp(64px,9.4vw,136px) clamp(20px,4vw,60px) 0">
      <div data-reveal="" style="display:flex;flex-direction:column;align-items:center;text-align:center">
        <span style="display:inline-flex;align-items:center;padding:9px 16px;border-radius:999px;background:#E4EDEE;border:1px solid #CBDCDE;box-shadow:0 1px 2px rgba(0,0,0,.04);font-size:13px;font-weight:500;color:#3F5A66">Para el asesor</span>
        <h2 style="margin:20px 0 0;font-size:clamp(32px,5.2vw,74px);line-height:1.06;letter-spacing:-.04em;font-weight:800;color:#172A3A;text-wrap:balance">Menos tardes en el carro.<br />Más cierres al <span style="font-family:'Playfair Display',serif;font-style:italic;font-weight:500;letter-spacing:-.02em">mes</span>.</h2>
      </div>
      <div data-3col="" style="margin-top:clamp(34px,4vw,54px);display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,1.6vw,16px)">
        <div data-reveal="" style="background:#fff;border:1px solid #DCE6E7;border-radius:20px;padding:26px;box-shadow:0 1px 2px rgba(0,0,0,.03),0 18px 34px -26px rgba(0,0,0,.35);transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s" style-hover="transform:translateY(-4px);box-shadow:0 1px 2px rgba(0,0,0,.03),0 26px 44px -26px rgba(0,0,0,.4)">
          <span style="display:flex;width:52px;height:52px;border-radius:15px;background:#004346;color:#fff;align-items:center;justify-content:center;box-shadow:0 10px 18px -12px rgba(0,0,0,.9)">
            <i class="ph ph-car" style="font-size:25px;line-height:1"></i>
          </span>
          <h3 style="margin:52px 0 0;font-size:20px;font-weight:700;letter-spacing:-.02em;color:#172A3A">La tarde entera, por un link</h3>
          <p style="margin:10px 0 0;font-size:16px;line-height:1.8;color:#3F5A66;text-wrap:pretty">Hoy le muestras diez propiedades en una tarde completa y le gusta una. Con tour, las recorre todas desde su casa y tú sales a mostrar las dos que de verdad quiere.</p>
        </div>
        <div data-reveal="" style="background:#fff;border:1px solid #DCE6E7;border-radius:20px;padding:26px;box-shadow:0 1px 2px rgba(0,0,0,.03),0 18px 34px -26px rgba(0,0,0,.35);transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s" style-hover="transform:translateY(-4px);box-shadow:0 1px 2px rgba(0,0,0,.03),0 26px 44px -26px rgba(0,0,0,.4)">
          <span style="display:flex;width:52px;height:52px;border-radius:15px;background:#004346;color:#fff;align-items:center;justify-content:center;box-shadow:0 10px 18px -12px rgba(0,0,0,.9)">
            <i class="ph ph-trend-up" style="font-size:25px;line-height:1"></i>
          </span>
          <h3 style="margin:52px 0 0;font-size:20px;font-weight:700;letter-spacing:-.02em;color:#172A3A">Llega a la visita ya decidido</h3>
          <p style="margin:10px 0 0;font-size:16px;line-height:1.8;color:#3F5A66;text-wrap:pretty">Ya vio la distribución, el tamaño y la vista. No estás explicando la planta: estás cerrando. Menos días en mercado, más propiedades movidas al mes.</p>
        </div>
        <div data-reveal="" style="background:#fff;border:1px solid #DCE6E7;border-radius:20px;padding:26px;box-shadow:0 1px 2px rgba(0,0,0,.03),0 18px 34px -26px rgba(0,0,0,.35);transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s" style-hover="transform:translateY(-4px);box-shadow:0 1px 2px rgba(0,0,0,.03),0 26px 44px -26px rgba(0,0,0,.4)">
          <span style="display:flex;width:52px;height:52px;border-radius:15px;background:#004346;color:#fff;align-items:center;justify-content:center;box-shadow:0 10px 18px -12px rgba(0,0,0,.9)">
            <i class="ph ph-key" style="font-size:25px;line-height:1"></i>
          </span>
          <h3 style="margin:52px 0 0;font-size:20px;font-weight:700;letter-spacing:-.02em;color:#172A3A">Te ganas la exclusiva</h3>
          <p style="margin:10px 0 0;font-size:16px;line-height:1.8;color:#3F5A66;text-wrap:pretty">El propietario firma con quien llega con mejor material a esa reunión. Y nadie más en Cali llega con un escaneo 3D del apartamento.</p>
        </div>
      </div>

      <!-- CTA intermedio -->
      <div data-reveal="" data-ctaband="" style="margin-top:clamp(16px,1.8vw,20px);background:#fff;border:1px solid #DCE6E7;border-radius:20px;padding:clamp(22px,2.6vw,30px);display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;box-shadow:0 1px 2px rgba(0,0,0,.03),0 18px 34px -26px rgba(0,0,0,.35)">
        <div style="display:flex;flex-direction:column;gap:6px;flex:1 1 300px">
          <span style="font-size:clamp(19px,1.9vw,24px);font-weight:700;letter-spacing:-.025em;color:#172A3A;text-wrap:pretty">¿Cuál es la propiedad que llevas más tiempo sin vender?</span>
          <span style="font-size:15px;line-height:1.7;color:#3F5A66;text-wrap:pretty">Esa es la que escaneamos gratis. Mándanos la dirección por WhatsApp y coordinamos.</span>
        </div>
        <a href="https://wa.me/573011493222?text=Hola%2C%20tengo%20una%20propiedad%20que%20no%20he%20podido%20vender%20y%20quiero%20escanearla%20gratis." target="_blank" rel="noopener" style="flex:0 0 auto;display:inline-flex;align-items:center;gap:9px;padding:15px 24px;border-radius:12px;background:#172A3A;color:#fff;font-size:15.5px;font-weight:600;box-shadow:0 14px 26px -16px rgba(0,0,0,.85);transition:transform .25s cubic-bezier(.2,.8,.2,1),background .25s" style-hover="transform:translateY(-2px);background:#004346;color:#fff">
          <i class="ph-fill ph-whatsapp-logo" style="font-size:18px;line-height:1;color:#09BC8A"></i>
          Escanear esa propiedad
        </a>
      </div>
    </section>

    <!-- ── MARQUEE DE BARRIOS ── -->
    <div data-marquee="" style="margin-top:clamp(28px,3.4vw,44px);padding:18px 0;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)">
      <div style="display:flex;width:max-content;animation-name:vis-marquee;animation-timing-function:linear;animation-iteration-count:infinite;animation-duration:{{ marqueeDur }}">
        <div style="display:flex;align-items:center;gap:clamp(30px,4vw,58px);padding-right:clamp(30px,4vw,58px)">
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Ciudad Jardín</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">El Peñón</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Granada</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Santa Teresita</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Pance</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Normandía</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">San Fernando</span>
        </div>
        <div style="display:flex;align-items:center;gap:clamp(30px,4vw,58px);padding-right:clamp(30px,4vw,58px)" aria-hidden="true">
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Ciudad Jardín</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">El Peñón</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Granada</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Santa Teresita</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Pance</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">Normandía</span>
          <span style="font-size:15px;font-weight:500;color:#3F5A66;white-space:nowrap">San Fernando</span>
        </div>
      </div>
    </div>

    <!-- ── GALERÍA DE TOURS (carrusel) ── -->
    <section id="tours" style="width:100%;max-width:1320px;margin:0 auto;padding:clamp(56px,9.4vw,136px) clamp(20px,4vw,60px) 0">
      <div data-reveal="" style="display:flex;flex-direction:column;align-items:center;text-align:center">
        <span style="display:inline-flex;align-items:center;padding:9px 16px;border-radius:999px;background:#E4EDEE;border:1px solid #CBDCDE;box-shadow:0 1px 2px rgba(0,0,0,.04);font-size:13px;font-weight:500;color:#3F5A66">Tours</span>
        <h2 style="margin:20px 0 0;font-size:clamp(32px,5.2vw,74px);line-height:1.06;letter-spacing:-.04em;font-weight:800;color:#172A3A">Así se ve tu<br /><span style="font-family:'Playfair Display',serif;font-style:italic;font-weight:500;letter-spacing:-.02em">propiedad</span> por dentro</h2>
      </div>
      <div data-reveal="" style="margin-top:clamp(30px,3.6vw,48px);position:relative">
        <div style="overflow:hidden;border-radius:22px">
          <div style="display:flex;gap:16px;will-change:transform;transition:transform .65s cubic-bezier(.22,.8,.2,1);transform:{{ trackX }}">
            <sc-for list="{{ slides }}" as="s" hint-placeholder-count="3">
              <article data-zoom="" style="flex:0 0 {{ slideBasis }};position:relative;aspect-ratio:.575;border-radius:22px;overflow:hidden;background:#D6E2E3">
                <span data-zoom-img="" style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,#DBE6E7 0 10px,#C9D8DA 10px 20px);display:flex;align-items:center;justify-content:center">
                  <span style="font:500 11px/1.5 ui-monospace,SFMono-Regular,monospace;letter-spacing:.04em;color:#83989F;text-align:center;padding:0 18px">{{ s.ph }}</span>
                </span>
                <span style="position:absolute;left:0;right:0;bottom:0;height:58%;background:linear-gradient(180deg,transparent,rgba(10,10,10,.82))"></span>
                <div style="position:absolute;left:20px;right:20px;bottom:22px;color:#fff">
                  <span style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:500;color:rgba(255,255,255,.9)">
                    <i class="ph {{ s.icon }}" style="font-size:14px;line-height:1"></i>
                    {{ s.badge }}
                  </span>
                  <h3 style="margin:10px 0 0;font-size:22px;font-weight:700;letter-spacing:-.02em">{{ s.title }}</h3>
                  <p style="margin:5px 0 0;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72)">{{ s.sub }}</p>
                </div>
              </article>
            </sc-for>
          </div>
        </div>
        <button type="button" aria-label="Anterior" onClick="{{ prev }}" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:999px;border:none;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);color:#172A3A;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 18px -10px rgba(0,0,0,.6);transition:background .2s,transform .2s" style-hover="background:#fff;transform:translateY(-50%) scale(1.07)">
          <i class="ph ph-caret-left" style="font-size:15px;line-height:1"></i>
        </button>
        <button type="button" aria-label="Siguiente" onClick="{{ next }}" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:999px;border:none;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);color:#172A3A;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 18px -10px rgba(0,0,0,.6);transition:background .2s,transform .2s" style-hover="background:#fff;transform:translateY(-50%) scale(1.07)">
          <i class="ph ph-caret-right" style="font-size:15px;line-height:1"></i>
        </button>
      </div>
      <div data-reveal="" style="margin-top:22px;display:flex;justify-content:center">
        <div style="display:flex;align-items:center;gap:7px;padding:12px 14px;border-radius:999px;background:#E1EAEB">
          <sc-for list="{{ dots }}" as="d" hint-placeholder-count="6">
