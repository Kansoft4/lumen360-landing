      <div data-reveal="" style="margin-top:clamp(30px,3.6vw,46px);max-width:608px;margin-left:auto;margin-right:auto;background:#fff;border:1px solid #DCE6E7;border-radius:22px;padding:clamp(20px,2.2vw,30px);box-shadow:0 1px 2px rgba(0,0,0,.03),0 26px 50px -36px rgba(0,0,0,.45)">
